{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "berry-game.json",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "executable"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$", "description": "Lowercase letters, digits and '-'." },
    "displayName": { "type": "string", "minLength": 2, "maxLength": 60 },
    "version": { "type": "string", "maxLength": 20 },
    "executable": { "type": "string", "pattern": "^[A-Za-z0-9 _.()+-]{1,80}\\.[eE][xX][eE]$", "description": "Program file name, no folders." },
    "maxPlayers": { "type": "integer", "minimum": 2, "maximum": 64, "default": 4 },
    "gamePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "protocol": { "enum": ["udp", "tcp", "both"], "default": "udp" },
    "connect": { "type": "array", "minItems": 1, "items": { "enum": ["lan", "vlan", "wireguard", "ip", "direct", "dedicated", "directplay", "steam"] }, "uniqueItems": true },
    "hostArgs": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 200 }, "description": "Command-line arguments when the player hosts." },
    "joinArgs": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 200 }, "description": "Arguments when joining. Placeholders: {host} {port}." },
    "sdk": {
      "type": "object", "additionalProperties": false,
      "properties": { "permissions": { "type": "array", "items": { "enum": ["identity", "room", "players", "presence", "achievements", "scores", "token", "network", "lan", "friends", "profile"] }, "uniqueItems": true } }
    }
  }
}
